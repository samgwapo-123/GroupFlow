@page "/"
@inject ProjectState State

<h1 class="text-2xl font-semibold tracking-tight">Welcome back, Psalm</h1>
<p class="mt-1.5 text-sm text-muted">Here is where the @State.Name stands today.</p>

<div class="mt-7 grid grid-cols-2 gap-4 lg:grid-cols-4">
    @foreach (var (value, label) in stats)
    {
        <div class="@Ui.Card">
            <p class="text-3xl font-semibold">@value</p>
            <p class="text-sm text-muted">@label</p>
        </div>
    }
</div>

<div class="@Ui.Card mt-4">
    <div class="mb-3 flex justify-between">
        <h2 class="font-semibold">Project progress</h2>
        <span class="text-sm text-muted">@State.DoneCount of @State.Total tasks done</span>
    </div>
    <div class="h-2 rounded-full bg-line">
        <div class="h-2 rounded-full bg-accent" style="width:@(State.Progress)%"></div>
    </div>
</div>

<div class="mt-4 grid gap-4 lg:grid-cols-[1.3fr_1fr]">
    <div class="@Ui.Card">
        <h2 class="font-semibold">Current work</h2>
        @foreach (var t in State.Tasks.Where(t => t.Status != "Done"))
        {
            <div class="mt-3 flex items-center justify-between rounded-lg border border-line bg-bg px-4 py-3">
                <div>
                    <p class="text-sm font-medium">@t.Title</p>
                    <p class="text-xs text-muted">@t.AssignedTo</p>
                </div>
                <span class="@Ui.Badge @Ui.Status(t.Status)">@t.Status</span>
            </div>
        }
    </div>
    <div class="@Ui.Card">
        <h2 class="font-semibold">Who is doing what</h2>
        @foreach (var m in State.Members)
        {
            var total = State.MemberTotal(m.Name);
            var done = State.MemberDone(m.Name);
            var pct = total == 0 ? 0 : done * 100 / total;
            <div class="mt-4 flex items-center gap-3">
                <div class="@m.Bg flex size-8 items-center justify-center rounded-full text-xs font-semibold text-bg">@m.Name[0]</div>
                <div class="flex-1">
                    <p class="mb-1.5 flex justify-between text-sm font-medium">@m.Name <span class="font-normal text-muted">@done / @total</span></p>
                    <div class="h-2 rounded-full bg-line"><div class="h-2 rounded-full bg-ok" style="width:@(pct)%"></div></div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    (string, string)[] stats => new[]
    {
        (State.Members.Count.ToString(), "Members"),
        (State.Total.ToString(), "Total tasks"),
        (State.Pending.ToString(), "Still pending"),
        (State.Progress + "%", "Progress"),
    };
}