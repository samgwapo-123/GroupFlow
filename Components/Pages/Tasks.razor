@page "/tasks"
@inject ProjectState State

<div class="flex items-start justify-between">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Tasks</h1>
        <p class="mt-1.5 text-sm text-muted">Manage your group's project work.</p>
    </div>
    <button class="@Ui.Primary" @onclick="() => showForm = !showForm">+ Add task</button>
</div>

@if (showForm)
{
    <div class="@Ui.Card mt-6 grid gap-4 md:grid-cols-3">
        <label class="text-sm md:col-span-3">Task title
            <input class="@Ui.Field mt-1" @bind="draft.Title" @bind:event="oninput" />
        </label>
        <label class="text-sm md:col-span-3">Description
            <input class="@Ui.Field mt-1" @bind="draft.Description" @bind:event="oninput" />
        </label>
        <label class="text-sm">Assigned to
            <select class="@Ui.Field mt-1" @bind="draft.AssignedTo">
                @foreach (var m in State.Members) { <option>@m.Name</option> }
            </select>
        </label>
        <label class="text-sm">Priority
            <select class="@Ui.Field mt-1" @bind="draft.Priority">
                <option>Low</option><option>Medium</option><option>High</option>
            </select>
        </label>
        <label class="text-sm">Status
            <select class="@Ui.Field mt-1" @bind="draft.Status">
                <option>To Do</option><option>In Progress</option><option>Done</option>
            </select>
        </label>
        <div class="flex gap-2 md:col-span-3">
            <button class="@Ui.Secondary" @onclick="Cancel">Cancel</button>
            <button class="@Ui.Primary" @onclick="Add">Add task</button>
        </div>
    </div>
}

<div class="mt-7 grid items-start gap-4 md:grid-cols-3">
    @foreach (var status in statuses)
    {
        var column = State.Tasks.Where(t => t.Status == status).ToList();
        <div class="rounded-xl border border-line bg-white/[0.02] p-3">
            <h2 class="flex justify-between px-1 text-sm font-semibold">@status <span class="font-normal text-muted">@column.Count</span></h2>
            @foreach (var t in column)
            {
                <div class="mt-3 rounded-lg border border-line bg-card p-4">
                    <p class="text-sm font-medium">@t.Title</p>
                    @if (t.Description != "") { <p class="mt-1 text-xs leading-snug text-muted">@t.Description</p> }
                    <div class="mt-3 flex items-center justify-between">
                        <span class="text-xs text-gray-400">@t.AssignedTo</span>
                        <span class="@Ui.Badge @Ui.Priority(t.Priority)">@t.Priority</span>
                    </div>
                    <div class="mt-3 flex gap-4 border-t border-line pt-3 text-xs">
                        @if (t.Status != "Done") { <button class="text-ok hover:underline" @onclick="() => MarkDone(t)">Mark done</button> }
                        <button class="text-bad hover:underline" @onclick="() => State.Tasks.Remove(t)">Delete</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    string[] statuses = { "To Do", "In Progress", "Done" };
    bool showForm;
    ProjectTask draft = new();

    protected override void OnInitialized() => draft = NewDraft();

    ProjectTask NewDraft() => new() { AssignedTo = State.Members[0].Name };

    void MarkDone(ProjectTask t) => t.Status = "Done";

    void Add()
    {
        if (string.IsNullOrWhiteSpace(draft.Title)) return;
        State.AddTask(draft);
        Cancel();
    }

    void Cancel()
    {
        draft = NewDraft();
        showForm = false;
    }
}